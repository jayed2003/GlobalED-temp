datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum AdminPermission {
  DESTINATIONS
  COURSES
  BLOGS
  EVENTS
  IELTS
  LEADS
  TESTIMONIALS
  MESSAGES
  // CMS sections (each shown in the admin form once its section exists)
  PAGES
  SERVICES
  FAQS
  TEAM
  SETTINGS
}

enum CourseCategory {
  IELTS
  ENGLISH
  OTHER_LANGUAGES
}

enum BlogCategory {
  COUNTRY_WISE
  SCHOLARSHIPS
  IELTS
  ENGLISH
}

enum EventStatus {
  UPCOMING
  PREVIOUS
}

enum LeadFormType {
  GENERAL
  IELTS
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum ContactMessageStatus {
  NEW
  REPLIED
  CLOSED
}

model AdminUser {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         AdminRole         @default(EDITOR)
  // Ignored when role is ADMIN (master admins always have full access).
  permissions  AdminPermission[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  activities   ActivityLog[]
}

enum ActivityAction {
  CREATED
  UPDATED
  PUBLISHED
  UNPUBLISHED
  DELETED
  BULK_DELETED
  STATUS_CHANGED
  SIGNED_IN
}

/// Who changed what, and when. Written by src/lib/activity.ts.
model ActivityLog {
  id          String         @id @default(cuid())
  // Null once the admin is deleted; adminName keeps who it was.
  adminId     String?
  admin       AdminUser?     @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName   String
  action      ActivityAction
  // "blog", "course", "page", ... (see ENTITY_LABELS in src/lib/activity.ts)
  entityType  String
  entityId    String?
  // What the item was called at the time, e.g. the post title.
  entityLabel String         @default("")
  // Extra context, e.g. "Status: Contacted" or "3 items".
  details     String         @default("")
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([entityType, entityId])
}

model Destination {
  id              String                  @id @default(cuid())
  slug            String                  @unique
  name            String
  tagline         String
  heroImage       String
  heroImageAlt    String                  @default("")
  flagImage       String
  flagImageAlt    String                  @default("")
  overview        String                  @db.Text
  whyStudyHere    String[]
  tuitionRange    String
  livingCost      String
  scholarships    String[]
  visaInfo        String[]
  sortOrder       Int                     @default(0)
  // Draft = hidden from visitors (menu, lists, booking form); admins can preview.
  publishStatus   ContentStatus           @default(PUBLISHED)
  // SEO (all optional; empty = fall back to the name, tagline and hero image)
  seoTitle        String                  @default("")
  metaDescription String                  @default("")
  ogImage         String                  @default("")
  ogImageAlt      String                  @default("")
  universities    DestinationUniversity[]
  faqs            DestinationFaq[]
  leads           Lead[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model DestinationUniversity {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  city          String
  sortOrder     Int         @default(0)
}

model DestinationFaq {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  q             String
  a             String      @db.Text
  sortOrder     Int         @default(0)
}

model Course {
  id              String                   @id @default(cuid())
  slug            String                   @unique
  title           String
  category        CourseCategory
  image           String
  imageAlt        String                   @default("")
  overview        String                   @db.Text
  curriculum      String[]
  duration        String
  schedule        String
  price           String
  badge           String?
  sortOrder       Int                      @default(0)
  // Draft = hidden from visitors (menu, lists, booking form); admins can preview.
  publishStatus   ContentStatus            @default(PUBLISHED)
  // SEO (all optional; empty = fall back to the title, overview and image)
  seoTitle        String                   @default("")
  metaDescription String                   @default("")
  ogImage         String                   @default("")
  ogImageAlt      String                   @default("")
  ieltsUsedIn     IeltsPreparationCourse[]
  leads           Lead[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model IeltsContent {
  id                         String                   @id @default("main")
  whatIsIeltsTitle           String
  whatIsIeltsBody            String                   @db.Text
  whatIsIeltsPoints          String[]
  whyIeltsTitle              String
  whyIeltsBody               String                   @db.Text
  whyIeltsReasons            Json
  whyGlobaledTitle           String
  whyGlobaledBody            String                   @db.Text
  whyGlobaledUsps            Json
  whyGlobaledFreeServices    Json
  preparationTitle           String
  preparationBody            String                   @db.Text
  preparationSkillAreas      Json
  preparationCourses         IeltsPreparationCourse[]
  progressTrackerTitle       String
  progressTrackerBody        String                   @db.Text
  progressTrackerTrackItems  String[]
  progressTrackerBenefits    String[]
  successStoriesTitle        String
  successStoriesBody         String                   @db.Text
  successStoriesAchievements Json
  successStoriesQuotes       String[]
  updatedAt                  DateTime                 @updatedAt
}

model IeltsPreparationCourse {
  id             String       @id @default(cuid())
  ieltsContentId String
  ieltsContent   IeltsContent @relation(fields: [ieltsContentId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)

  @@unique([ieltsContentId, courseId])
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  category        BlogCategory
  coverImage      String
  coverImageAlt   String        @default("")
  excerpt         String        @db.Text
  content         String        @db.Text
  author          String
  publishedAt     DateTime
  // SEO (all optional; empty = fall back to title / excerpt / cover image)
  focusKeyword    String        @default("")
  seoTitle        String        @default("")
  metaDescription String        @default("")
  ogImage         String        @default("")
  ogImageAlt      String        @default("")
  // Draft = hidden whatever the publish date; admins can preview.
  publishStatus   ContentStatus @default(PUBLISHED)
  featured        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model EventItem {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  status          EventStatus
  date            DateTime
  time            String
  venue           String
  bannerImage     String
  bannerImageAlt  String        @default("")
  description     String        @db.Text
  gallery         String[]
  // Alt text for each gallery photo, same order as `gallery`.
  galleryAlts     String[]      @default([])
  // Draft = hidden from visitors; admins can preview. (`status` is Upcoming / Previous.)
  publishStatus   ContentStatus @default(PUBLISHED)
  // SEO (all optional; empty = fall back to the title, description and banner)
  seoTitle        String        @default("")
  metaDescription String        @default("")
  ogImage         String        @default("")
  ogImageAlt      String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Lead {
  id               String       @id @default(cuid())
  formType         LeadFormType
  name             String
  phone            String
  email            String
  branch           String
  destinationId    String?
  destination      Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  destinationOther String?
  studyLevel       String?
  ieltsStatus      String?
  funding          String?
  courseId         String?
  course           Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  preferredDate    DateTime?
  message          String?      @db.Text
  status           LeadStatus   @default(NEW)
  // Set the first time an admin opens the lead; null = unread (the "New" badge).
  readAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Testimonial {
  id             String   @id @default(cuid())
  studentName    String
  reviewImage    String
  reviewImageAlt String   @default("")
  university     String
  country        String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Messages sent through the public Contact form (managed under Admin → Messages).
model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  // Set the first time an admin opens the message; null = unread.
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}

/// Site-wide settings (one row, id "main"): contact details, social links,
/// headline numbers, footer text and the call-to-action banner.
/// Edited under Admin → Settings → Site settings.
model SiteSettings {
  id                      String   @id @default("main")
  brandName               String
  tagline                 String
  /// As displayed, e.g. "019555 44772"; tel: links are built from it.
  phone                   String
  email                   String
  /// International format, digits only, e.g. "8801955544772" (for wa.me links).
  whatsapp                String
  facebookUrl             String   @default("")
  instagramUrl            String   @default("")
  linkedinUrl             String   @default("")
  youtubeUrl              String   @default("")
  footerBlurb             String   @default("")
  statStudentsPlaced      String
  statPartnerUniversities String
  statVisaSuccessRate     String
  statYearsOfExperience   String
  ctaTitle                String
  ctaText                 String
  faqCtaTitle             String
  faqCtaText              String
  updatedAt               DateTime @updatedAt
}

/// An office. Shown on the contact page and footer, and offered in the
/// booking form (leads keep the branch *name*, so renaming one is safe).
model Branch {
  id          String   @id @default(cuid())
  name        String   @unique
  address     String
  phones      String[]
  email       String
  hours       String
  /// Google Maps embed URL ("" = no map).
  mapEmbedUrl String   @default("")
  shown       Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Editable page content (Admin → Pages), one row per page key — see
/// src/lib/pages/defs.ts for each page's fields. `published` is what visitors
/// see; `draft` holds saved-but-unpublished changes (visible only in preview).
model SitePage {
  key           String   @id
  published     Json
  draft         Json?
  /// Who last saved (draft or publish), for the Pages list.
  updatedByName String   @default("")
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Draft = saved but not on the site (visible only in preview); Published = live.
enum ContentStatus {
  DRAFT
  PUBLISHED
}

/// A service (Admin → Services): its own page under /services, a card on the
/// home page and services page, and a link in the menu and footer.
model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  /// Icon name from src/lib/icons.ts
  icon             String
  shortDescription String
  description      String        @db.Text
  benefits         String[]
  /// Steps: [{ step, description }]
  process          Json
  status           ContentStatus @default(PUBLISHED)
  sortOrder        Int           @default(0)
  seoTitle         String        @default("")
  metaDescription  String        @default("")
  ogImage          String        @default("")
  ogImageAlt       String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum FaqCategory {
  GENERAL
  STUDY_ABROAD
  IELTS
}

/// A question on the FAQs page (Admin → FAQs). Destinations have their own FAQs.
model Faq {
  id             String      @id @default(cuid())
  question       String
  answer         String      @db.Text
  category       FaqCategory
  /// Also listed under "Common Questions About Our Services" on /services.
  showOnServices Boolean     @default(false)
  shown          Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum TeamGroup {
  BOARD
  TEAM
}

/// A person on the Our Team page (Admin → Team): Board of Directors or staff.
model TeamMember {
  id        String    @id @default(cuid())
  name      String
  role      String
  photo     String
  photoAlt  String    @default("")
  bio       String    @default("")
  group     TeamGroup @default(TEAM)
  shown     Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
