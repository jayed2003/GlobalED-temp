# PostgreSQL connection string (e.g. a free Neon project, or Vercel Postgres).
# Pooled connection, used at runtime.
DATABASE_URL=
# Direct/non-pooling connection, used by Prisma migrations.
DIRECT_URL=

# NextAuth/Auth.js session secret — generate with `openssl rand -base64 32`
# or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=

# Seeded admin account (created by `prisma/seed.ts` on first run).
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Vercel Blob token for admin image uploads. Must be a PUBLIC-access store —
# private stores can't serve images via a plain URL.
BLOB_READ_WRITE_TOKEN=

# Resend API key for lead confirmation emails and contact-form notifications.
# Until this is set, emails are skipped (leads still save to the DB fine).
RESEND_API_KEY=
RESEND_FROM_EMAIL="GlobalEd <onboarding@resend.dev>"
COMPANY_NOTIFY_EMAIL="info@globaled.io"

# Rate limiting store (Upstash Redis). Add it from Vercel -> Storage ->
# Marketplace -> Upstash; Vercel then sets these automatically (it may name
# them KV_REST_API_URL / KV_REST_API_TOKEN instead — both work).
# Unset = per-instance in-memory limits (fine for local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
