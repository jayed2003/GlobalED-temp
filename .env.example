
# Template for .env — copy to .env and fill in. This file is committed; .env
# (with the real values) never is.

# PostgreSQL connection string (e.g. a free Neon project, or Vercel Postgres).
# Pooled connection, used at runtime.
DATABASE_URL=
# Direct/non-pooling connection, used by Prisma migrations.
DIRECT_URL=

# NextAuth/Auth.js session secret — generate with `openssl rand -base64 32`
# or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=

# Public URL of the site, no trailing slash (sitemap, robots.txt, metadata,
# links in admin emails). e.g. https://globaled.io
NEXT_PUBLIC_SITE_URL=

# Master admin account for `npx prisma db seed`. Safe way to create it on any
# database (deletes nothing): SEED_ADMIN_ONLY=1 npx prisma db seed
# Add SEED_ADMIN_RESET_PASSWORD=1 to reset an existing admin's password.
# The full seed (without SEED_ADMIN_ONLY) wipes content and refuses to run on a
# database that has data unless SEED_CONFIRM_RESET=<that database's host>.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Vercel Blob token for admin image uploads. Must be a PUBLIC-access store —
# private stores can't serve images via a plain URL.
BLOB_READ_WRITE_TOKEN=

# Resend: student confirmations, new-lead alerts and contact-form emails.
# Until RESEND_API_KEY is set, emails are skipped (leads and messages still
# save). The FROM address must be on a domain verified in Resend — otherwise
# Resend only delivers to the account owner's own address.
RESEND_API_KEY=
RESEND_FROM_EMAIL="GlobalEd <onboarding@resend.dev>"
# Where new-lead alerts and contact-form messages are emailed.
COMPANY_NOTIFY_EMAIL="info@globaled.io"

# Rate limiting store (Upstash Redis). Add it from Vercel -> Storage ->
# Marketplace -> Upstash for Redis; Vercel then sets these automatically.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
# Unset = per-instance in-memory limits (fine for local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudflare Turnstile (bot check on the consultation/IELTS and contact forms).
# Create a widget in the Cloudflare dashboard -> Turnstile, list the site's
# domains under Hostnames, then copy the keys here and into Vercel.
# Unset in development = Cloudflare's always-pass test keys are used.
# Unset in production = forms are refused (fails closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
